bin/
# mise writes resolved versions here; the pins in config.toml are the source
.mise.lock

# Subway Seat writes generated theme files into the linked config dirs. They
# are build output of oddurs/subway-seat, regenerated by `polkadot theme`, and
# do not belong in this repo's history. The flavor itself is declared in
# steps.go; the lines that turn it on live between `# >>> subway-seat >>>`
# markers in the configs that are tracked.
config/atuin/themes/
config/bat/themes/
config/btop/themes/
config/fish/themes/
config/ghostty/themes/
config/nvim/colors/
config/nvim/doc/
config/nvim/lua/lualine/
config/nvim/lua/subway-seat/
config/herdr/subway-seat*
config/herdr/london-*
config/herdr/paris-*
config/lazygit/subway-seat*.yml
config/lazygit/london-*.yml
config/lazygit/paris-*.yml
config/fish/conf.d/subway-seat.fish
config/tmux/subway-seat*.conf
config/tmux/london-*.conf
config/tmux/paris-*.conf

# Runtime state that apps write into the linked config dirs: fish's universal
# variables, completions other tools install for themselves, and herdr's
# session, plugin checkouts and backups. None of it is configuration.
config/fish/fish_variables
config/fish/completions/*
!config/fish/completions/polkadot.fish
config/herdr/session.json
config/herdr/release-notes.json
config/herdr/.plugins.lock
config/herdr/plugins/
config/herdr/*.bak-*
