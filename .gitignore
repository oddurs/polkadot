bin/
# Personal shell settings are intentionally machine-local.
config/fish/conf.d/90-local.fish
# A local git identity can override the shared defaults without changing them.
home/gitconfig.local
# mise writes resolved versions here; the pins in config.toml are the source
.mise.lock

# Compatibility ignores for artifacts from the earlier external theme setup.
# The London Moquette bundle now lives in theme/; these keep an upgraded
# machine from gaining unrelated worktree noise.
config/*/themes/
!config/fish/themes/
config/fish/themes/*
!config/fish/themes/london-moquette.theme
config/nvim/colors/
config/nvim/doc/subway-seat.txt
config/nvim/lua/subway-seat/
config/nvim/lua/lualine/themes/
config/lazygit/*.yml
config/delta/
config/eza/
config/atuin/themes/

# herdr writes session state beside its config.
config/herdr/session*.json
config/herdr/.plugins.lock

# opencode: skills and machine state
config/opencode/skills/
config/opencode/node_modules/
config/opencode/bun.lock
config/opencode/package*.json

# herdr writes release notes beside its config too.
config/herdr/release-notes.json

# herdr downloads plugins here; they are clones, not configuration.
config/herdr/plugins/

# skills synced down from claude.ai; machine-written, not authored here
config/claude/skills/synced/
