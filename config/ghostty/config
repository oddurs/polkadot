# ─── ghostty ──────────────────────────────────────────────────────────────
# Managed by polkadot: ~/Code/polkadot/config/ghostty/config

# Theme.
#
# Gotham is a single dark palette — there is no light counterpart, so it is set
# unconditionally. Halide's computed themes are still in ./themes/ and follow
# macOS appearance in pairs; swap the commented line back in to use them.
#
#   ghostty +list-themes    browse everything with live preview
theme = gotham
# theme = dark:cyanotype-slate-dark,light:cyanotype-slate-light

# ─── type ─────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 12%

# ─── window ───────────────────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-inherit-working-directory = true
window-save-state = always
macos-titlebar-style = tabs
macos-option-as-alt = true

# ─── behaviour ────────────────────────────────────────────────────────────
scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title
mouse-hide-while-typing = true

# ─── keys ─────────────────────────────────────────────────────────────────
# Splits, the way tmux would if it were native.
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+k=clear_screen

# Mac shortcuts, forwarded into the editor.
#
# Ghostty would otherwise swallow these. `text:` sends the CSI-u encoding for
# the key with the super modifier (9 = super, 10 = super+shift), which Neovim
# decodes to <D-s>, <D-Z> and so on. Anything that does not understand CSI-u
# parses the sequence and discards it, so the shell is unaffected.
#
# Cmd+C, Cmd+V and Cmd+X are deliberately absent: they stay Ghostty's own
# copy and paste, which already work correctly inside Neovim.
keybind = cmd+s=text:\x1b[115;9u
keybind = cmd+z=text:\x1b[122;9u
keybind = cmd+shift+z=text:\x1b[122;10u
keybind = cmd+a=text:\x1b[97;9u
keybind = cmd+f=text:\x1b[102;9u
keybind = cmd+shift+f=text:\x1b[102;10u
keybind = cmd+p=text:\x1b[112;9u
keybind = cmd+b=text:\x1b[98;9u
keybind = cmd+slash=text:\x1b[47;9u
