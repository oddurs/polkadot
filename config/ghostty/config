# ─── ghostty ──────────────────────────────────────────────────────────────
# Managed by polkadot: ~/Code/polkadot/config/ghostty/config

# Theme.
#
# Set by Subway Seat, in the marked block at the end of this file — it is last
# so it wins, and `subway-seat switch <flavor>` rewrites it in place. Every
# flavor's palette is in ./themes/, which is generated and not tracked.
#
#   ghostty +list-themes    browse everything with live preview

# ─── type ─────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 12%

# ─── window ───────────────────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-inherit-working-directory = true
window-save-state = always
macos-titlebar-style = tabs
macos-option-as-alt = true

# The Mac panel is wider than sRGB, and the palette is hand-picked, so hand
# Ghostty the wider space rather than letting it clamp.
window-colorspace = display-p3

# The dimensions popup on every drag is noise once you know the font size.
resize-overlay = never

# Homebrew installed this as a cask, so let `brew upgrade` own the binary.
# An app that updates itself would be writing to a file brew believes it
# manages — the same trade `fresh` makes in its own config.
auto-update = off

# ─── behaviour ────────────────────────────────────────────────────────────
# Bytes, not lines — the default is 10_000_000, so the old 100000 here was a
# hundredth of stock rather than a large buffer. Allocation is lazy and per
# surface, so a high ceiling costs nothing until it is actually filled.
scrollback-limit = 100000000
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title
mouse-hide-while-typing = true

# ─── keys ─────────────────────────────────────────────────────────────────
# Splits, the way tmux would if it were native.
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+k=clear_screen

# Reload after editing this file, without losing the session. Useful while
# changing flavors, since `subway-seat switch` rewrites the block below.
keybind = cmd+shift+comma=reload_config

# A drop-down terminal over whatever is in front. cmd+shift+` rather than
# plain cmd+` — global bindings are taken from every other app, and cmd+`
# is macOS's own cycle-windows-in-app.
keybind = global:cmd+shift+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1

# Mac shortcuts, forwarded into the editor.
#
# Ghostty would otherwise swallow these. `text:` sends the CSI-u encoding for
# the key with the super modifier (9 = super, 10 = super+shift), which Neovim
# decodes to <D-s>, <D-Z> and so on. Anything that does not understand CSI-u
# parses the sequence and discards it, so the shell is unaffected.
#
# Cmd+C, Cmd+V and Cmd+X are deliberately absent: they stay Ghostty's own
# copy and paste, which already work correctly inside Neovim.
keybind = cmd+s=text:\x1b[115;9u
keybind = cmd+z=text:\x1b[122;9u
keybind = cmd+shift+z=text:\x1b[122;10u
keybind = cmd+a=text:\x1b[97;9u
keybind = cmd+f=text:\x1b[102;9u
keybind = cmd+shift+f=text:\x1b[102;10u
keybind = cmd+p=text:\x1b[112;9u
keybind = cmd+b=text:\x1b[98;9u
keybind = cmd+slash=text:\x1b[47;9u

# >>> subway-seat >>>
theme = Paris Guimard
# <<< subway-seat <<<
