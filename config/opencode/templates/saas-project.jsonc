{
  "$schema": "https://opencode.ai/config.json",

  // ===================
  // PROJECT OVERRIDES
  // ===================
  // Copy this to your project root as opencode.json
  // Project settings override global config

  // Point to your project's coding guidelines
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md"
  ],

  // Project-specific permissions (inherit globals, add project-specific)
  "permission": {
    "bash": {
      // Allow project scripts
      "npm run dev*": "allow",
      "npm run build*": "allow",
      "npm run lint*": "allow",
      "npx prisma *": "allow",
      "npx supabase *": "allow"
    }
  },

  // Additional ignore patterns for this project
  "watcher": {
    "ignore": [
      ".env*",
      "*.local"
    ]
  }
}
